{
  "name": "painel-senha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:baseline": "prisma migrate resolve --applied 0001_initial",
    "db:studio": "prisma studio",
    "db:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "postinstall": "prisma generate",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.7",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
